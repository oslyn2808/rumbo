# Puerto del servidor
PORT=4000

# Secreto para firmar las sesiones (minimo 32 caracteres).
# Ejecuta "npm run setup" y se genera solo. Nunca lo compartas ni lo subas a GitHub.
JWT_SECRET=

# Sin clave, la app funciona en MODO DEMO (respuestas de ejemplo).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Archivo de la base de datos (SQLite)
DATABASE_PATH=rumbo.db

# Origenes del frontend autorizados (el servidor de desarrollo de Vite usa el 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
